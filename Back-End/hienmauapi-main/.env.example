# PostgreSQL connection. Copy this file to .env and replace the placeholder values.
DB_URL=jdbc:postgresql://localhost:5432/blooddonate
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-postgresql-password

# Keep Hibernate validation-only when Flyway owns the schema.
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false

# Generate a unique random value of at least 32 characters for local use.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=3600000

# Comma-separated, exact browser origins. Never use * with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
