# Base URL of the backend REST API (no trailing slash)
VITE_BASE_URL=http://localhost:8080

# Base URL used to resolve images/files returned by the API
VITE_IMAGE_BASE_URL=http://localhost:8080/

# TinyMCE API key used by the rich-text editor in blog/notification management
# (staff and admin portals only). Get a free key at https://www.tiny.cloud/.
VITE_TINYMCE_API_KEY=

